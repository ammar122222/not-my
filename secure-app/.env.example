# ============================================================
# Access Portal — environment variables
# Copy to .env.local for local dev. On Vercel, add these in
# Project Settings → Environment Variables.
# NEVER prefix a secret key with NEXT_PUBLIC_ and NEVER import
# service-role keys into client components.
# ============================================================

# Supabase project URL (Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anonymous key (safe for the browser; RLS enforces authz)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-anon-key...

# Optional: server-only secret used ONLY in privileged server code
# (not required by this app — kept out of client bundles by design).
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...never-expose...

# App URL (used for password-recovery redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
